# Safe placeholders only. Do not commit credentials or connection strings.
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ENV=development
JWT_SECRET=replace-with-a-local-secret
CLEANSHEET_MASTER_KEY=replace-with-a-local-secret
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=cleansheet-private
REDIS_URL=
AUTH_ADMIN_EMAILS=admin@anclora.com
AUTH_WHITELIST_TOKEN_TTL_HOURS=72
AUTH_PASSWORD_MIN_LENGTH=12
# Comma-separated allowlist for backend/scripts/reset_qa_password.py — that
# tool refuses any email not listed here, and always refuses AUTH_ADMIN_EMAILS
# regardless of this list.
QA_RESET_ALLOWED_EMAILS=qa.cleansheet@anclora.local

# Anclora Identity OIDC login (Wave 1 pilot). Fail-closed: unset/false keeps
# the existing whitelist/password login as the only path
# (backend/anclora_identity_oidc.py). Never auto-provisions a new CleanSheet
# account — only links an OIDC login to an email that already has an active
# whitelist-provisioned account.
ANCLORA_IDENTITY_ENABLED=false
ANCLORA_IDENTITY_ISSUER_URL=
ANCLORA_IDENTITY_CLIENT_ID=cleansheet
ANCLORA_IDENTITY_CLIENT_SECRET=
ANCLORA_IDENTITY_REDIRECT_URI=http://localhost:8000/api/auth/anclora-identity/callback
ANCLORA_IDENTITY_POST_LOGIN_REDIRECT=/app
# Signs the short-lived (10 min) OIDC handshake cookie only, never the app session.
ANCLORA_IDENTITY_SESSION_SECRET=
